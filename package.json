{
  "name": "@lifarl/react-scroll-snap-slider",
  "version": "3.0.0-alpha",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite examples",
    "build": "rm -rf ./dist && rollup -c && postcss src/styles.css -o dist/styles.css",
    "build:pages": "rm -rf ./dist && vite build examples --outDir ../dist --emptyOutDir --base=/react-scroll-snap-slider/ && postcss src/styles.css -o dist/styles.css",
    "deploy:pages": "node scripts/deploy-pages.js",
    "lint": "eslint .",
    "prepare": "husky",
    "prepack": "yarn build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifarl/react-scroll-snap-slider.git"
  },
  "homepage": "https://lifarl.github.io/react-scroll-snap-slider",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "examples/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "style": "./dist/styles.css",
  "keywords": [
    "react",
    "carousel",
    "scroll snapping",
    "scroll snap",
    "scroll",
    "slider"
  ],
  "author": "lifarl",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.8.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.64.6",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "react": ">=16.8.3",
    "react-dom": ">=16.8.3"
  },
  "packageManager": "yarn@4.9.4",
  "lint-staged": {
    "**/*.{cjs,js,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
